<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Hide only the top status bar; retain Android's bottom navigation. -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#0B1220</item>
        <item name="android:navigationBarColor">#0B1220</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:colorAccent">#2EAAFF</item>
    </style>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Hide only the top status bar; retain Android's bottom navigation. -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">#F1F5FA</item>
        <item name="android:navigationBarColor">#F1F5FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#F1F5FA</item>
        <item name="android:colorAccent">#1686CF</item>
    </style>
</resources>
